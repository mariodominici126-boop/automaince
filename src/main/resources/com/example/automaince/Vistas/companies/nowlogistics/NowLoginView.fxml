<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<HBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.automaince.controllers.NowLoginController" alignment="CENTER" spacing="0" style="-fx-font-family: 'Segoe UI'; -fx-background-color: #f2f5f6;">
  <VBox alignment="CENTER" spacing="20" prefWidth="440" prefHeight="570" style="-fx-background-color: #28265f; -fx-background-radius: 16 0 0 16;"><padding><Insets top="36" right="34" bottom="36" left="34"/></padding><ImageView fitWidth="235" fitHeight="150" preserveRatio="true"><image><Image url="@../images/now-logistics.png"/></image></ImageView><Label text="NOW Logistics" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/><Label text="Acceso al portal de mantenimiento" wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #d5d8f0;"/></VBox>
  <VBox spacing="17" prefWidth="470" prefHeight="570" style="-fx-background-color: white; -fx-background-radius: 0 16 16 0;"><padding><Insets top="48" right="48" bottom="38" left="48"/></padding>
    <Label text="Bienvenido" style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #292842;"/><Label text="Inicia sesión en NOW Logistics" style="-fx-font-size: 13px; -fx-text-fill: #727a83;"/>
    <Label text="Usuario" style="-fx-font-weight: bold; -fx-text-fill: #3e3d58;"/><TextField fx:id="username" promptText="Usuario corporativo" style="-fx-padding: 11; -fx-background-color: #f8f9fa; -fx-border-color: #dce1e5; -fx-border-radius: 7; -fx-background-radius: 7;"/>
    <Label text="Contraseña" style="-fx-font-weight: bold; -fx-text-fill: #3e3d58;"/><PasswordField fx:id="password" promptText="Contraseña" style="-fx-padding: 11; -fx-background-color: #f8f9fa; -fx-border-color: #dce1e5; -fx-border-radius: 7; -fx-background-radius: 7;"/>
    <Label fx:id="feedback" wrapText="true" minHeight="34" style="-fx-font-size: 11px; -fx-text-fill: #b3261e;"/>
    <Button text="Iniciar sesión" maxWidth="Infinity" onAction="#login" style="-fx-background-color: #2e306e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 7;"/>
    <Button text="← Volver a empresas" onAction="#back" style="-fx-background-color: transparent; -fx-text-fill: #596671; -fx-padding: 9 0;"/>
  </VBox>
</HBox>
