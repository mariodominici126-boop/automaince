<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.automaince.controllers.MainController" style="-fx-font-family: 'Segoe UI'; -fx-background-color: #f4f7f8;">
  <left>
    <VBox spacing="9" prefWidth="225" style="-fx-background-color: #102b3a;">
      <padding><Insets top="24" right="16" bottom="20" left="16"/></padding>
      <Label text="◈ AutoMaince" style="-fx-text-fill: white; -fx-font-size: 21px; -fx-font-weight: bold;"/>
      <Label text="GESTIÓN INTELIGENTE" style="-fx-text-fill: #8cb0ba; -fx-font-size: 10px; -fx-padding: 7 0 9 0;"/>
      <Button text="▦  Dashboard" onAction="#dashboard" style="-fx-alignment: CENTER_LEFT; -fx-background-color: transparent; -fx-text-fill: #e4eff2; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 7;"/>
      <Button text="▣  Vehículos" onAction="#vehicles" style="-fx-alignment: CENTER_LEFT; -fx-background-color: transparent; -fx-text-fill: #e4eff2; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 7;"/>
      <Button text="▤  Órdenes" onAction="#orders" style="-fx-alignment: CENTER_LEFT; -fx-background-color: transparent; -fx-text-fill: #e4eff2; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 7;"/>
      <Button text="⌁  Mantenimiento" onAction="#maintenance" style="-fx-alignment: CENTER_LEFT; -fx-background-color: transparent; -fx-text-fill: #e4eff2; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 7;"/>
      <Button text="◉  Combustible" onAction="#fuel" style="-fx-alignment: CENTER_LEFT; -fx-background-color: transparent; -fx-text-fill: #e4eff2; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 7;"/>
      <Button text="⚒  Reparaciones" onAction="#repairs" style="-fx-alignment: CENTER_LEFT; -fx-background-color: transparent; -fx-text-fill: #e4eff2; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 7;"/>
      <Button text="▤  Piezas" onAction="#parts" style="-fx-alignment: CENTER_LEFT; -fx-background-color: transparent; -fx-text-fill: #e4eff2; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 7;"/>
      <Button text="▧  Documentos" onAction="#documents" style="-fx-alignment: CENTER_LEFT; -fx-background-color: transparent; -fx-text-fill: #e4eff2; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 7;"/>
      <Button text="⚠  Alertas" onAction="#alerts" style="-fx-alignment: CENTER_LEFT; -fx-background-color: transparent; -fx-text-fill: #e4eff2; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 7;"/>
      <Button text="⌁  Analytics" onAction="#analytics" style="-fx-alignment: CENTER_LEFT; -fx-background-color: transparent; -fx-text-fill: #e4eff2; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 7;"/>
      <Button text="✦  Intelligence" onAction="#intelligence" style="-fx-alignment: CENTER_LEFT; -fx-background-color: transparent; -fx-text-fill: #e4eff2; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 7;"/>
      <Region VBox.vgrow="ALWAYS"/>
      <Label text="Datos compartidos · V2" style="-fx-text-fill: #8cb0ba;"/>
    </VBox>
  </left>
  <center>
    <VBox spacing="12" style="-fx-background-color: #f4f7f8;">
      <padding><Insets top="18" right="24" bottom="22" left="24"/></padding>
      <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-background-color: transparent;"><Label fx:id="connectionStatus" text="Conectando…" style="-fx-text-fill: #73818a;"/><Region HBox.hgrow="ALWAYS"/><Label text="Operación AutoMaince" style="-fx-text-fill: #73818a;"/></HBox>
      <StackPane fx:id="pageHost" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;"/>
    </VBox>
  </center>
</BorderPane>
