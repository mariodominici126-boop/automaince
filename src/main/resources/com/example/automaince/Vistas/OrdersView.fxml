<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.automaince.controllers.OrdersController" spacing="18" style="-fx-font-family: 'Segoe UI'; -fx-background-color: transparent;">
  <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: transparent;">
    <VBox spacing="5" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;"><Label fx:id="pageTitle" text="Órdenes de mantenimiento" style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #163747;"/><Label fx:id="pageDescription" text="Coordina el trabajo pendiente y su avance operativo." style="-fx-font-size: 13px; -fx-text-fill: #73818a;"/></VBox>
    <HBox fx:id="actions" spacing="9" alignment="CENTER_RIGHT" style="-fx-padding: 3 0 4 0;"/>
  </HBox>
  <HBox alignment="CENTER" spacing="8" style="-fx-background-color: #eaf1f3; -fx-background-radius: 10; -fx-padding: 14;">
    <Label text="CREADA" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 7 12; -fx-text-fill: #087f79; -fx-font-weight: bold;"/><Label text="›" style="-fx-font-size: 18px; -fx-text-fill: #91a2aa;"/>
    <Label text="REVISIÓN" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 7 12; -fx-text-fill: #506a73; -fx-font-weight: bold;"/><Label text="›" style="-fx-font-size: 18px; -fx-text-fill: #91a2aa;"/>
    <Label text="AUTORIZADA" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 7 12; -fx-text-fill: #506a73; -fx-font-weight: bold;"/><Label text="›" style="-fx-font-size: 18px; -fx-text-fill: #91a2aa;"/>
    <Label text="EN PROCESO" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 7 12; -fx-text-fill: #506a73; -fx-font-weight: bold;"/><Label text="›" style="-fx-font-size: 18px; -fx-text-fill: #91a2aa;"/>
    <Label text="COMPLETADA" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 7 12; -fx-text-fill: #506a73; -fx-font-weight: bold;"/><Label text="›" style="-fx-font-size: 18px; -fx-text-fill: #91a2aa;"/>
    <Label text="CERRADA" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 7 12; -fx-text-fill: #506a73; -fx-font-weight: bold;"/>
  </HBox>
  <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;">
    <HBox alignment="CENTER_LEFT" style="-fx-background-color: transparent;"><Label text="Flujo de trabajo" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #173d4c;"/><Region HBox.hgrow="ALWAYS"/><Label text="Selecciona una orden para avanzar su estado" style="-fx-font-size: 11px; -fx-text-fill: #73818a;"/></HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8;"/>
  </VBox>
</VBox>
