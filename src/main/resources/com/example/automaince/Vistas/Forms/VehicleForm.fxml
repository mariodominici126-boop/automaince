<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.automaince.controllers.VehicleFormController" hgap="12" vgap="10" minWidth="440" style="-fx-font-family: 'Segoe UI'; -fx-background-color: white;">
  <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
  <Label style="-fx-text-fill: #344954; -fx-font-weight: bold;" text="Placa" GridPane.rowIndex="0"/><TextField style="-fx-pref-width: 260; -fx-padding: 8 10; -fx-background-color: white; -fx-border-color: #cbd5dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #243944;" fx:id="plate" promptText="ABC-123" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
  <Label style="-fx-text-fill: #344954; -fx-font-weight: bold;" text="Marca" GridPane.rowIndex="1"/><TextField style="-fx-pref-width: 260; -fx-padding: 8 10; -fx-background-color: white; -fx-border-color: #cbd5dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #243944;" fx:id="brand" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
  <Label style="-fx-text-fill: #344954; -fx-font-weight: bold;" text="Modelo" GridPane.rowIndex="2"/><TextField style="-fx-pref-width: 260; -fx-padding: 8 10; -fx-background-color: white; -fx-border-color: #cbd5dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #243944;" fx:id="model" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
  <Label style="-fx-text-fill: #344954; -fx-font-weight: bold;" text="Año" GridPane.rowIndex="3"/><TextField style="-fx-pref-width: 260; -fx-padding: 8 10; -fx-background-color: white; -fx-border-color: #cbd5dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #243944;" fx:id="year" promptText="2024" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
  <Label style="-fx-text-fill: #344954; -fx-font-weight: bold;" text="Tipo" GridPane.rowIndex="4"/><ComboBox style="-fx-pref-width: 260; -fx-padding: 8 10; -fx-background-color: white; -fx-border-color: #cbd5dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #243944;" fx:id="type" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
  <Label style="-fx-text-fill: #344954; -fx-font-weight: bold;" text="Conductor" GridPane.rowIndex="5"/><TextField style="-fx-pref-width: 260; -fx-padding: 8 10; -fx-background-color: white; -fx-border-color: #cbd5dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #243944;" fx:id="driver" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
  <Label style="-fx-text-fill: #344954; -fx-font-weight: bold;" text="Próximo mantenimiento" GridPane.rowIndex="6"/><DatePicker style="-fx-pref-width: 260; -fx-padding: 8 10; -fx-background-color: white; -fx-border-color: #cbd5dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #243944;" fx:id="nextMaintenance" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
</GridPane>
