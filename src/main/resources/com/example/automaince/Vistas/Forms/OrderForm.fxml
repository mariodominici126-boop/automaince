<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.automaince.controllers.OrderFormController" hgap="12" vgap="10" minWidth="470" style="-fx-font-family: 'Segoe UI'; -fx-background-color: white;">
  <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
  <Label style="-fx-text-fill: #344954; -fx-font-weight: bold;" text="Vehículo" GridPane.rowIndex="0"/><ComboBox style="-fx-pref-width: 260; -fx-padding: 8 10; -fx-background-color: white; -fx-border-color: #cbd5dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #243944;" fx:id="vehicle" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
  <Label style="-fx-text-fill: #344954; -fx-font-weight: bold;" text="Tipo" GridPane.rowIndex="1"/><ComboBox style="-fx-pref-width: 260; -fx-padding: 8 10; -fx-background-color: white; -fx-border-color: #cbd5dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #243944;" fx:id="type" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
  <Label style="-fx-text-fill: #344954; -fx-font-weight: bold;" text="Prioridad" GridPane.rowIndex="2"/><ComboBox style="-fx-pref-width: 260; -fx-padding: 8 10; -fx-background-color: white; -fx-border-color: #cbd5dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #243944;" fx:id="priority" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
  <Label style="-fx-text-fill: #344954; -fx-font-weight: bold;" text="Proveedor" GridPane.rowIndex="3"/><TextField style="-fx-pref-width: 260; -fx-padding: 8 10; -fx-background-color: white; -fx-border-color: #cbd5dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #243944;" fx:id="provider" promptText="Taller o proveedor" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
  <Label style="-fx-text-fill: #344954; -fx-font-weight: bold;" text="Trabajo solicitado" GridPane.rowIndex="4"/><TextArea style="-fx-pref-width: 260; -fx-padding: 8 10; -fx-background-color: white; -fx-border-color: #cbd5dc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #243944;" fx:id="description" promptText="Describa el servicio requerido" prefRowCount="4" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
</GridPane>
