<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.automaince.controllers.AnalyticsController" spacing="18" style="-fx-font-family: 'Segoe UI'; -fx-background-color: transparent;">
  <VBox spacing="5" style="-fx-background-color: transparent;"><Label fx:id="pageTitle" text="Analytics" style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #163747;"/><Label fx:id="pageDescription" text="Indicadores de costo, consumo y confiabilidad de la flota." style="-fx-font-size: 13px; -fx-text-fill: #73818a;"/></VBox>
  <HBox spacing="12" style="-fx-background-color: transparent;">
    <VBox spacing="6" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;"><Label text="COSTOS" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #087f79;"/><Label text="Combustible y mantenimiento" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #173d4c;"/><Label text="Desglose operativo consultado a la API." style="-fx-text-fill: #73818a;"/></VBox>
    <VBox spacing="6" HBox.hgrow="ALWAYS" style="-fx-background-color: #edf3f5; -fx-background-radius: 10; -fx-padding: 16;"><Label text="UTILIZACIÓN" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #4b7790;"/><Label text="Consumo y disponibilidad" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #173d4c;"/><Label text="Indicadores calculados con el historial actual." style="-fx-text-fill: #73818a;"/></VBox>
    <VBox spacing="6" HBox.hgrow="ALWAYS" style="-fx-background-color: #f4efff; -fx-background-radius: 10; -fx-padding: 16;"><Label text="CONFIABILIDAD" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #7654a3;"/><Label text="Comparación por vehículo" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3d3152;"/><Label text="Explora los registros debajo." style="-fx-text-fill: #716780;"/></VBox>
  </HBox>
  <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;">
    <Label text="Indicadores de la flota" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #173d4c;"/><TableView fx:id="table" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8;"/>
  </VBox>
</VBox>
