<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.automaince.MainController" stylesheets="@app.css" styleClass="root-shell">
  <left><VBox spacing="9" prefWidth="225" styleClass="sidebar"><padding><Insets top="24" right="16" bottom="20" left="16"/></padding>
    <Label text="◈ AutoMaince" styleClass="brand"/><Label text="GESTIÓN INTELIGENTE" styleClass="eyebrow"/>
    <Button text="▦  Dashboard" onAction="#dashboard"/><Button text="▣  Camionetas" onAction="#vehicles"/><Button text="▤  Órdenes" onAction="#orders"/><Button text="⌁  Mantenimiento" onAction="#maintenance"/><Button text="⚒  Reparaciones" onAction="#repairs"/><Button text="▤  Piezas" onAction="#parts"/><Button text="▧  Documentos" onAction="#documents"/><Button text="⚠  Alertas" onAction="#alerts"/><Button text="⌁  Analytics" onAction="#analytics"/><Button text="✦  Intelligence" onAction="#intelligence"/>
    <Region VBox.vgrow="ALWAYS"/><Label text="Datos compartidos · V2" styleClass="muted"/>
  </VBox></left>
  <center><VBox spacing="12" styleClass="main-area"><padding><Insets top="18" right="24" bottom="22" left="24"/></padding>
    <HBox alignment="CENTER_RIGHT" spacing="10"><Label fx:id="connectionStatus" text="Conectando…" styleClass="muted"/><Region HBox.hgrow="ALWAYS"/><Label text="Operación AutoMaince" styleClass="top-note"/></HBox>
    <StackPane fx:id="pageHost" VBox.vgrow="ALWAYS"/>
  </VBox></center>
</BorderPane>
