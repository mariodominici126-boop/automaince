{
  "name": "automaince",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema web de mantenimiento y operación para equipos de PrintPilot y flotas empresariales",
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1"
  }
}
